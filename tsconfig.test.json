{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/dsh-*": [
        "./node_modules/@deepseek-ai/dsh-*/src"
      ],
      "@deepseek-ai/dsh-*/*": [
        "./node_modules/@deepseek-ai/dsh-*/src/*"
      ]
    }
  },
  "include": [
    "src",
    "tests"
  ]
}
